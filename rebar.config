{erl_opts, [debug_info, {i, "include"}]}.

{deps, [
    {cowboy, "2.12.0"},
    {gproc,  "1.0.0"},
    {thoas,  "1.0.0"}
]}.

{shell, [
    {apps, [concrete]}
]}.

{plugins, [rebar3_ex_doc]}.

{ex_doc, [
    {extras, [
        "README.md",
        {"tutorial/README.md", #{filename => <<"tutorial-overview">>}},
        "tutorial/01-getting-started.md",
        "tutorial/02-compile-erlang-to-javascript.md",
        "tutorial/03-use-the-javascript-in-your-own-page.md",
        "tutorial/04-language-features.md",
        "tutorial/05-talking-to-the-dom.md",
        "tutorial/06-bundles-and-dead-code-elimination.md",
        "tutorial/07-templates.md",
        "tutorial/08-full-page-hydration-and-actions.md",
        "tutorial/09-testing-your-code.md"
    ]},
    {main, "README.md"},
    {groups_for_extras, [
        {<<"Tutorial">>, [
            <<"tutorial/README.md">>,
            <<"tutorial/01-getting-started.md">>,
            <<"tutorial/02-compile-erlang-to-javascript.md">>,
            <<"tutorial/03-use-the-javascript-in-your-own-page.md">>,
            <<"tutorial/04-language-features.md">>,
            <<"tutorial/05-talking-to-the-dom.md">>,
            <<"tutorial/06-bundles-and-dead-code-elimination.md">>,
            <<"tutorial/07-templates.md">>,
            <<"tutorial/08-full-page-hydration-and-actions.md">>,
            <<"tutorial/09-testing-your-code.md">>
        ]}
    ]}
]}.

%% "example" is compiled only under this profile (rebar3 as example
%% compile/shell). Keeping it out of the base extra_src_dirs means its
%% compiled output doesn't end up as a stray code path that confuses
%% rebar3 ex_doc's app-path scanning.
{profiles, [
    {example, [{extra_src_dirs, ["example"]}]}
]}.

%% Tests run in parallel. Common Test has no config-level parallel
%% switch — parallelism comes from each suite declaring its cases in a
%% [parallel] group (see the all_parallel group in every *_SUITE).
%% Suites themselves always run sequentially; cases within them don't.
{ct_opts, [
    {include, ["include"]}
]}.
