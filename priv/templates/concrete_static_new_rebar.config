{erl_opts, [debug_info]}.

%% concrete is only used at build time (concrete:compile_module/1, called
%% from {{name}}_build:build/0) -- it's never started as an OTP
%% application, so its own cowboy/gproc/thoas deps get fetched and
%% compiled but never run.
{deps, [
    {concrete, {git, "https://github.com/wmealing/concrete.git", {branch, "main"}}}
]}.

{shell, [
    {apps, [{{name}}]}
]}.
