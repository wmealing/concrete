{erl_opts, [debug_info]}.

{deps, [
    {concrete, {git, "https://github.com/wmealing/concrete.git", {branch, "main"}}}
]}.

%% Registers concrete's rebar_compiler_concrete plugin so `rebar3 compile`
%% also produces JS bundles for every page module in this project.
{project_plugins, [
    {concrete, {git, "https://github.com/wmealing/concrete.git", {branch, "main"}}}
]}.

{shell, [
    {config, "config/sys.config"},
    {apps, [{{name}}]},
    %% r3:compile() reloads every dependency's modules on each run by
    %% default (rebar_agent:refresh_paths/1), purging+reloading ranch and
    %% cowboy even when nothing in them changed. code:purge/1 kills any
    %% process still running the old code, which can take down ranch's
    %% own acceptor supervisor after a couple of recompiles. None of
    %% these apps are edited during development, so exclude them from
    %% reload.
    {app_reload_blacklist, [ranch, cowboy, cowlib, gproc]}
]}.
