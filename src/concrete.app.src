{application, concrete, [
    {description, "Erlang port of Hologram — full-stack isomorphic web framework"},
    {vsn, "0.1.0"},
    {registered, [concrete_sup, concrete_assets, concrete_registry]},
    {mod, {concrete_app, []}},
    {applications, [
        kernel,
        stdlib,
        cowboy,
        gproc,
        thoas
    ]},
    {env, [{port, 4000}]},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, []}
 ]}.
